// TYGCP website — persistence layer.
//
// Scope decision (see README.md "Content & Data Architecture" section for the
// full reasoning): only form-submission data is modeled here. Episodes, news,
// events, partners, etc. remain in src/data/*.ts for now (Phase 3 batches 4+
// will introduce dedicated models for those once the admin CRUD architecture
// is built) — this schema solves the one gap file-based content can never
// solve: submitted form data has to land somewhere durable.
//
// PHASE 3 BATCH 1: now pointed at PostgreSQL, the only provider that works on
// Vercel's serverless functions (SQLite's local-file approach never worked in
// production — see src/lib/db.ts's header comment for the full history of why
// this project shipped a hand-written node:sqlite implementation instead of a
// generated Prisma client during Phase 2, and what changed in Batch 1).
//
// PHASE 3 BATCH 1 CORRECTIVE UPDATE (Prisma 7): Prisma ORM 7 removed the
// `url` / `directUrl` fields from the `datasource` block entirely (schema
// validation now fails with P1012 if they're present) — connection strings
// are no longer part of the committed schema at all. Two things replace
// them, and the two-connection-string reasoning below is unchanged, just
// relocated:
//   - CLI / migrations (`prisma generate`, `prisma migrate`, `prisma
//     validate`, ...) now read their connection string from
//     `prisma.config.ts` at the project root, which points at DIRECT_URL —
//     your provider's DIRECT (unpooled) connection string. See that file
//     for why: some pooling proxies (including Neon's default pooled
//     endpoint) don't support the migration protocol.
//   - The running app no longer gets a connection string from the schema at
//     all. Prisma 7 requires an explicit driver adapter, constructed at
//     runtime with DATABASE_URL — your provider's POOLED connection string
//     — and passed into `new PrismaClient({ adapter })`. See src/lib/db.ts.
// Both DATABASE_URL and DIRECT_URL are still the two env vars you set (in
// Vercel, and in .env.local for local dev) — only *where Prisma reads them
// from* changed, not their names or their pooled-vs-direct meaning.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  reason    String
  message   String
  status    String   @default("new") // new | read | archived
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model MinisterQuestion {
  id        String   @id @default(cuid())
  name      String
  district  String?
  topic     String?
  question  String
  status    String   @default("new") // new | reviewed | featured | archived
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  // Double opt-in is not implemented yet (see README) — every subscriber is
  // recorded as unconfirmed until a real ESP integration adds a verification
  // step. Keeping the field now avoids a migration later.
  confirmed Boolean  @default(false)

  @@index([createdAt])
}

model RsvpSubmission {
  id         String   @id @default(cuid())
  name       String
  phone      String
  district   String?
  eventSlug  String
  eventTitle String
  createdAt  DateTime @default(now())

  // PHASE 4 BATCH 1: optional link to a real Event row, added additively.
  // Nullable and unrelated to any existing column, so every RSVP submitted
  // before this batch (and every one submitted after it, until a future
  // batch wires /api/rsvp to real DB-backed events — see that route's own
  // comment) keeps working identically with eventId simply left null.
  // eventSlug/eventTitle are NOT being removed or deprecated by this: they
  // remain the fields the live /api/rsvp endpoint actually writes today.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  @@index([eventSlug])
  @@index([createdAt])
  @@index([eventId])
}

// --- PHASE 4 BATCH 1: CMS foundation models --------------------------------
//
// Added per the Phase 4 Batch 1 brief: Episode, NewsArticle, and Event, the
// first three models for the eventual database-driven publishing platform.
// Public pages still read from src/data/*.ts (episodes.ts, news.ts,
// events.ts) — nothing in this batch points any public route at these new
// tables, and no migration has been run against the production database
// (see prisma/migrations' Batch 1 migration header comment). These models
// exist so the schema, the migration, and the admin foundation pages
// (src/app/admin/episodes, /news, /events) can all be built and reviewed
// together; wiring the public site to them, and building real CRUD editors
// for them, are future-batch work — explicitly out of scope here.
//
// No episodes, articles, or events are seeded by this batch. These are
// table definitions, not data.

model Episode {
  id     String  @id @default(cuid())
  slug   String  @unique
  title  String
  // Short description for listing/cards — distinct from `transcript`
  // (the full spoken content, when available).
  summary String

  // Sequential episode number. Nullable so a draft can exist before a
  // number is assigned; @@unique below still enforces no two *numbered*
  // episodes collide (Postgres unique indexes don't compare NULLs as
  // equal, so any number of drafts can share a null episodeNumber).
  episodeNumber Int?

  // "Guest information" per the brief — kept to the two fields an episode
  // card/detail page actually needs to credit a guest by name and role.
  // Multiple co-guests or a full guest bio/photo are a reasonable future
  // extension (a dedicated Guest model + join table) but are more than a
  // Batch 1 foundation needs; not building that speculatively now.
  guestName  String?
  guestTitle String?

  durationSeconds Int?
  coverImageUrl   String?

  // Distinct URL fields rather than one generic "link" — an episode
  // legitimately has independent audio, video, and per-platform links, and
  // a template rendering "listen on Spotify" vs "listen on Apple Podcasts"
  // needs to know which is which rather than parsing a single URL.
  audioUrl          String?
  videoUrl          String?
  spotifyUrl        String?
  applePodcastsUrl  String?
  youtubeUrl        String?

  transcript String?

  // Plain-string publishing status, matching this schema's existing
  // convention (ContactSubmission.status, MinisterQuestion.status) rather
  // than a Prisma enum — enums require a migration to add a new value,
  // which is more friction than this status set needs.
  status      String    @default("draft") // draft | scheduled | published
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeNumber])
  @@index([status])
  @@index([publishedAt])
}

model NewsArticle {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  summary String
  content String

  featuredImageUrl String?

  status      String    @default("draft") // draft | published
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Event {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  location    String?

  // Upcoming/past is derived from these at query time (e.g. `startsAt >
  // now()`), per the brief — deliberately no separate "isUpcoming" /
  // category flag to fall out of sync with the actual date.
  startsAt DateTime
  endsAt   DateTime?

  coverImageUrl String?

  status String @default("draft") // draft | published | cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inverse side of RsvpSubmission.event — see that field's comment for
  // why this is additive/nullable rather than a required backfill.
  rsvps RsvpSubmission[]

  @@index([status])
  @@index([startsAt])
}
