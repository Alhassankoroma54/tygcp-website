// TYGCP website — persistence layer.
//
// Scope decision (see README.md "Content & Data Architecture" section for the
// full reasoning): only form-submission data is modeled here. Episodes, news,
// events, partners, etc. remain in src/data/*.ts for now (Phase 3 batches 4+
// will introduce dedicated models for those once the admin CRUD architecture
// is built) — this schema solves the one gap file-based content can never
// solve: submitted form data has to land somewhere durable.
//
// PHASE 3 BATCH 1: now pointed at PostgreSQL, the only provider that works on
// Vercel's serverless functions (SQLite's local-file approach never worked in
// production — see src/lib/db.ts's header comment for the full history of why
// this project shipped a hand-written node:sqlite implementation instead of a
// generated Prisma client during Phase 2, and what changed in Batch 1).
//
// Two connection strings, not one, because Vercel's serverless functions open
// many short-lived connections — a single unpooled connection string can
// exhaust a small Postgres instance's connection limit under real traffic:
//   - DATABASE_URL — the connection the running app uses for every normal
//     query. Point this at your provider's POOLED connection string (Neon,
//     Supabase and Vercel Postgres — which runs on Neon — all provide one,
//     usually routed through PgBouncer).
//   - DIRECT_URL — used only by `prisma migrate`, never by the running app.
//     Point this at your provider's DIRECT (unpooled) connection string —
//     some pooling proxies don't support the migration protocol.
//   If your provider does NOT distinguish pooled vs. direct connections (a
//   single traditional Postgres instance, for example), set DIRECT_URL to
//   the exact same value as DATABASE_URL — both variables must still be
//   defined (Prisma requires every env() referenced in this file to resolve),
//   but there's no requirement that they point at different endpoints.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  reason    String
  message   String
  status    String   @default("new") // new | read | archived
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model MinisterQuestion {
  id        String   @id @default(cuid())
  name      String
  district  String?
  topic     String?
  question  String
  status    String   @default("new") // new | reviewed | featured | archived
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  // Double opt-in is not implemented yet (see README) — every subscriber is
  // recorded as unconfirmed until a real ESP integration adds a verification
  // step. Keeping the field now avoids a migration later.
  confirmed Boolean  @default(false)

  @@index([createdAt])
}

model RsvpSubmission {
  id         String   @id @default(cuid())
  name       String
  phone      String
  district   String?
  eventSlug  String
  eventTitle String
  createdAt  DateTime @default(now())

  @@index([eventSlug])
  @@index([createdAt])
}
