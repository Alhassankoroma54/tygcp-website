# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env* correctly excludes .env / .env.local (real values), but
# also matched .env.example by accident, which holds no secrets and is
# meant to be committed as the template for what variables to set (found
# while touching this file for Phase 3 Batch 1 — .env.example had silently
# never been tracked since the Phase 2 commit). The negation re-includes it.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (local SQLite dev database — never committed, never used in production)
/prisma/*.db
/prisma/*.db-journal
